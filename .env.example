# Nach .env kopieren und an die eigene Infrastruktur anpassen.
# .env selbst ist gitignored - echte Netzwerk-/Infrastrukturnamen gehoeren
# nicht ins Repo.

# Name des bereits existierenden externen Docker-Netzwerks, in dem der
# Reverse Proxy (z.B. Caddy) laeuft. docker-compose.yml haengt den
# notes-Container dort ein, sonst kann der Proxy ihn nicht erreichen
# (siehe docker-compose.yml: networks.caddy_net).
CADDY_NETWORK_NAME=caddy_net
